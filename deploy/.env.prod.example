# ARTEX production .env — คัดลอกเป็น .env แล้วแก้ทุกค่าที่มี CHANGE-ME
# chmod 600 .env  และอย่า commit ลง git (ดู .gitignore)
# ---------------------------------------------------------------------------

# ----- Image -----
# ปักหมุด version ให้ชัด อย่าใช้ latest บน production (reproducible + ตรวจสอบได้)
ARTEX_TAG=v0.3.7

# ----- Postgres -----
POSTGRES_USER=artex
# สุ่มด้วย: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE-ME-openssl-rand-base64-32
POSTGRES_DB=artex

# ----- Reverse proxy / Caddy -----
# โดเมนจริงที่ชี้มาที่เครื่องนี้ (Caddy จะออก TLS ให้อัตโนมัติผ่าน Let's Encrypt)
ARTEX_DOMAIN=artex.example.com
# ชั้น auth เพิ่มหน้า ARTEX (นอกเหนือจาก login ภายในของ ARTEX เอง)
ARTEX_BASICAUTH_USER=opsadmin
# สร้าง hash ด้วย: docker run --rm caddy caddy hash-password --plaintext 'your-strong-pass'
ARTEX_BASICAUTH_HASH=CHANGE-ME-caddy-hash-password
# จำกัด IP ที่เข้าถึงได้ (เช่น office/VPN). ใส่ 0.0.0.0/0 = เปิดทุกที่ (ไม่แนะนำ)
ARTEX_ALLOW_CIDR=10.0.0.0/8

# ----- LLM (แนะนำตั้งใน UI: System → LLM แทน เพื่อไม่ให้ key ค้างใน .env/env ของทุก process) -----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
# ถ้าต้องให้ทราฟฟิกไป LLM ออกผ่าน proxy กลาง ให้ตั้งที่นี่ (http/https/socks5)
ARTEX_LLM_PROXY=
