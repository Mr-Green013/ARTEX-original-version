# ARTEX self-host (.env สำหรับ docker-compose.local.yml) — คัดลอกเป็น .env
# chmod 600 .env และอย่า commit
# ---------------------------------------------------------------------------
ARTEX_TAG=latest

POSTGRES_USER=artex
# สุ่ม: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=artex

# LLM — แนะนำเว้นว่างแล้วไปตั้งใน UI (System → LLM) จะปลอดภัยกว่า
# ถ้าจะตั้งที่นี่: Anthropic ใช้ได้เลย; Gemini ต้อง build จาก branch ที่ patch แล้ว
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
